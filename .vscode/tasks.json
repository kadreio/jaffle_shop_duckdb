        "runOn": "folderOpen"
      },
      "presentation": {
        "panel": "shared",
        "close": false
      }
    },
    {
      "label": "dbt: Run",
      "type": "shell",
      "command": "dbt run",
      "presentation": {
        "panel": "shared",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "dbt: Test",
      "type": "shell",
      "command": "dbt test",
      "presentation": {
        "panel": "shared",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "dbt: Seed",
      "type": "shell",
      "command": "dbt seed",
      "presentation": {
        "panel": "shared",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "dbt: Generate Docs",
      "type": "shell",
      "command": "dbt docs generate",
      "presentation": {
        "panel": "shared",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "dbt: Serve Docs",
      "type": "shell",
      "command": "dbt docs serve",
